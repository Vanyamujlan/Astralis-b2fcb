# ==========================================
# Astralio Telegram Bot — Environment Config
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or real service account credentials to Git.

# --- Required: Telegram Bot ---
BOT_TOKEN="123456789:AAFakeExampleBotTokenReplaceMeBeforeDeploy"

# --- Required: Firebase / Google Cloud Firestore ---
FIREBASE_PROJECT_ID="astralio-demo-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-demo@astralio-demo-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDemoKeyOnly\n-----END PRIVATE KEY-----\n"
# Optional: specify a named Firestore database (leave empty for "(default)")
FIREBASE_DATABASE_ID=""

# --- Optional: AI Interpretation Service ---
# If AI_API_KEY is left empty, Astralio automatically uses full deterministic local interpretations.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_SECONDS="15"
AI_RATE_LIMIT_PER_MINUTE="5"

# --- Optional: Payments (Telegram Stars) ---
# Set to true only after enabling Telegram Stars in @BotFather
TELEGRAM_STARS_ENABLED="false"

# --- Optional: Geocoding & Runtime ---
GEOCODING_ENABLED="true"
GEOCODING_TIMEOUT_SECONDS="5"
LOG_LEVEL="INFO"

# --- AI Studio Applet Runtime Vars (unused by Python bot) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
